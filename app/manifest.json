{
  "manifestVersion": 2,
  "id": "manman-island",
  "name": "慢慢岛",
  "version": "1.0.1",
  "description": "Hana 内的慢慢岛：一次拥有一座岛，其余只读参观；居民可分析本 Agent 最近7天会话，把思考与直言挑错写入记录本。",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "minAppVersion": "1.3.6-beta",
  "capabilities": ["app/resources.write", "app/sessions.read", "app/models.infer", "app/tasks.manage"],
  "contributes": {
    "cards": [{
      "id": "island",
      "title": "慢慢岛",
      "description": "单岛陪伴与只读参观；点击居民的思考或工作，分析本 Agent 最近7天文字会话，在记录本查看结果和来源。",
      "route": "/island.html",
      "realization": "page",
      "siteNavEntry": true,
      "cardForm": "edge-to-edge",
      "titleMode": "hide",
      "pageIcon": "assets/island-nav.svg",
      "face": { "image": "assets/cover.png" }
    }]
  }
}
